{
  "env": {
    "PLAYGROUND_RESOURCE_MODE": "best_effort",
    "PLAYGROUND_IMAGE_REPOSITORY": "ghcr.io/robinson-ai-systems/github-mcp-runtime"
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "skipMiddlewareRequestBody": true,
  "headers": [
    {
      "source": "/v1/transfer/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/limits",
      "destination": "/api/oauth/authorize?page=limits"
    },
    {
      "source": "/connection",
      "destination": "/api/oauth/authorize?manage=1"
    },
    {
      "source": "/privacy",
      "destination": "/api/oauth/authorize?page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/oauth/authorize?page=terms"
    },
    {
      "source": "/security",
      "destination": "/api/oauth/authorize?page=security"
    },
    {
      "source": "/support",
      "destination": "/api/oauth/authorize?page=support"
    },
    {
      "source": "/status",
      "destination": "/api/oauth/authorize?page=status"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/security.txt",
      "destination": "/api/security-txt"
    },
    {
      "source": "/brand/icon-256.png",
      "destination": "/api/index?brand_icon=256"
    },
    {
      "source": "/brand/icon-64.png",
      "destination": "/api/index?brand_icon=64"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index?brand_icon=64"
    },
    {
      "source": "/favicon.png",
      "destination": "/api/index?brand_icon=64"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/api/openapi"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "live": true
    }
  },
  "crons": [
    {
      "path": "/api/marketplace/sweep",
      "schedule": "17 * * * *"
    }
  ]
}
