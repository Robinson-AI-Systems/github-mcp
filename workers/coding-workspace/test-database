#!/bin/sh
# Disposable local test database only. No production URLs, password or host mount.
set -eu
export PATH=/usr/lib/postgresql/15/bin:/usr/bin:/bin
export PGDATA="$HOME/postgres-test"
if [ ! -f "$PGDATA/PG_VERSION" ]; then
  initdb --username=workspace --auth-local=trust --auth-host=trust -D "$PGDATA" >/dev/null
fi
exec postgres -D "$PGDATA" -c listen_addresses=127.0.0.1 -c port=5432 -c unix_socket_directories=/tmp
