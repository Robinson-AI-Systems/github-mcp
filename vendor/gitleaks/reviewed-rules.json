{
  "source": "https://github.com/gitleaks/gitleaks/blob/5f6ec56cfa6f8c67648d863582c7ae2f206d5c1c/config/gitleaks.toml",
  "revision": "5f6ec56cfa6f8c67648d863582c7ae2f206d5c1c",
  "license": "MIT",
  "adaptation": "26 reviewed high-confidence provider rules. Go inline case flags normalized to JavaScript; atlasv1 case sensitivity retained. Captured credential span is redacted; recognized token suffix is conservatively extended to avoid partial-token leakage. No upstream entropy/allowlist engine or full corpus parity is claimed.",
  "rules": [
    {
      "id": "aws-access-token",
      "label": "aws access token",
      "source_regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b",
      "pattern": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b",
      "flags": "gd",
      "keywords": [
        "AKIA",
        "ASIA",
        "ABIA",
        "ACCA",
        "A3T"
      ]
    },
    {
      "id": "digitalocean-pat",
      "label": "digitalocean pat",
      "source_regex": "\\b(dop_v1_[a-f0-9]{64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(dop_v1_[a-f0-9]{64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "dop_v1_"
      ]
    },
    {
      "id": "gitlab-pat",
      "label": "gitlab pat",
      "source_regex": "glpat-[\\w-]{20}",
      "pattern": "glpat-[\\w-]{20}",
      "flags": "gd",
      "keywords": [
        "glpat-"
      ]
    },
    {
      "id": "grafana-api-key",
      "label": "grafana api key",
      "source_regex": "(?i)\\b(eyJrIjoi[A-Za-z0-9]{70,400}={0,3})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(eyJrIjoi[A-Za-z0-9]{70,400}={0,3})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gdi",
      "keywords": [
        "eyJrIjoi"
      ]
    },
    {
      "id": "hashicorp-tf-api-token",
      "label": "hashicorp tf api token",
      "source_regex": "(?i)[a-z0-9]{14}\\.(?-i:atlasv1)\\.[a-z0-9\\-_=]{60,70}",
      "pattern": "[A-Za-z0-9]{14}\\.atlasv1\\.[A-Za-z0-9\\-_=]{60,70}",
      "flags": "gd",
      "keywords": [
        ".atlasv1."
      ]
    },
    {
      "id": "huggingface-access-token",
      "label": "huggingface access token",
      "source_regex": "\\b(hf_(?i:[a-z]{34}))(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(hf_[a-z]{34})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gdi",
      "keywords": [
        "hf_"
      ]
    },
    {
      "id": "linear-api-key",
      "label": "linear api key",
      "source_regex": "lin_api_(?i)[a-z0-9]{40}",
      "pattern": "lin_api_[a-z0-9]{40}",
      "flags": "gdi",
      "keywords": [
        "lin_api_"
      ]
    },
    {
      "id": "mailgun-private-api-token",
      "label": "mailgun private api token",
      "source_regex": "(?i)[\\w.-]{0,50}?(?:mailgun)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(key-[a-f0-9]{32})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "[\\w.-]{0,50}?(?:mailgun)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[\\x60'\"\\s=]{0,5}(key-[a-f0-9]{32})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gdi",
      "keywords": [
        "mailgun"
      ]
    },
    {
      "id": "notion-api-token",
      "label": "notion api token",
      "source_regex": "\\b(ntn_[0-9]{11}[A-Za-z0-9]{32}[A-Za-z0-9]{3})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(ntn_[0-9]{11}[A-Za-z0-9]{32}[A-Za-z0-9]{3})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "ntn_"
      ]
    },
    {
      "id": "npm-access-token",
      "label": "npm access token",
      "source_regex": "(?i)\\b(npm_[a-z0-9]{36})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(npm_[a-z0-9]{36})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gdi",
      "keywords": [
        "npm_"
      ]
    },
    {
      "id": "openai-api-key",
      "label": "openai api key",
      "source_regex": "\\b(sk-(?:proj|svcacct|admin)-(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})T3BlbkFJ(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})\\b|sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(sk-(?:proj|svcacct|admin)-(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})T3BlbkFJ(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})\\b|sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "sk-"
      ]
    },
    {
      "id": "postman-api-token",
      "label": "postman api token",
      "source_regex": "\\b(PMAK-(?i)[a-f0-9]{24}\\-[a-f0-9]{34})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(PMAK-[a-f0-9]{24}\\-[a-f0-9]{34})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gdi",
      "keywords": [
        "PMAK-"
      ]
    },
    {
      "id": "pypi-upload-token",
      "label": "pypi upload token",
      "source_regex": "pypi-AgEIcHlwaS5vcmc[\\w-]{50,1000}",
      "pattern": "pypi-AgEIcHlwaS5vcmc[\\w-]{50,1000}",
      "flags": "gd",
      "keywords": [
        "pypi-"
      ]
    },
    {
      "id": "sendgrid-api-token",
      "label": "sendgrid api token",
      "source_regex": "\\b(SG\\.(?i)[a-z0-9=_\\-\\.]{66})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(SG\\.[a-z0-9=_\\-\\.]{66})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gdi",
      "keywords": [
        "SG."
      ]
    },
    {
      "id": "shopify-access-token",
      "label": "shopify access token",
      "source_regex": "shpat_[a-fA-F0-9]{32}",
      "pattern": "shpat_[a-fA-F0-9]{32}",
      "flags": "gd",
      "keywords": [
        "shpat_"
      ]
    },
    {
      "id": "slack-app-token",
      "label": "slack app token",
      "source_regex": "(?i)xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+",
      "pattern": "xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+",
      "flags": "gdi",
      "keywords": [
        "xapp-"
      ]
    },
    {
      "id": "slack-bot-token",
      "label": "slack bot token",
      "source_regex": "xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*",
      "pattern": "xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*",
      "flags": "gd",
      "keywords": [
        "xoxb-"
      ]
    },
    {
      "id": "slack-config-access-token",
      "label": "slack config access token",
      "source_regex": "(?i)xoxe.xox[bp]-\\d-[A-Z0-9]{163,166}",
      "pattern": "xoxe.xox[bp]-\\d-[A-Z0-9]{163,166}",
      "flags": "gdi",
      "keywords": [
        "xoxe."
      ]
    },
    {
      "id": "slack-config-refresh-token",
      "label": "slack config refresh token",
      "source_regex": "(?i)xoxe-\\d-[A-Z0-9]{146}",
      "pattern": "xoxe-\\d-[A-Z0-9]{146}",
      "flags": "gdi",
      "keywords": [
        "xoxe-"
      ]
    },
    {
      "id": "slack-legacy-token",
      "label": "slack legacy token",
      "source_regex": "xox[os]-\\d+-\\d+-\\d+-[a-fA-F\\d]+",
      "pattern": "xox[os]-\\d+-\\d+-\\d+-[a-fA-F\\d]+",
      "flags": "gd",
      "keywords": [
        "xoxo-",
        "xoxs-"
      ]
    },
    {
      "id": "slack-user-token",
      "label": "slack user token",
      "source_regex": "xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}",
      "pattern": "xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}",
      "flags": "gd",
      "keywords": [
        "xoxp-",
        "xoxe-"
      ]
    },
    {
      "id": "stripe-access-token",
      "label": "stripe access token",
      "source_regex": "\\b((?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b((?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "sk_",
        "rk_"
      ]
    },
    {
      "id": "anthropic-admin-api-key",
      "label": "anthropic admin api key",
      "source_regex": "\\b(sk-ant-admin01-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(sk-ant-admin01-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "sk-ant-"
      ]
    },
    {
      "id": "anthropic-api-key",
      "label": "anthropic api key",
      "source_regex": "\\b(sk-ant-api03-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(sk-ant-api03-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "sk-ant-"
      ]
    },
    {
      "id": "azure-ad-client-secret",
      "label": "azure ad client secret",
      "source_regex": "(?:^|[\\\\'\"\\x60\\s>=:(,)])([a-zA-Z0-9_~.]{3}\\dQ~[a-zA-Z0-9_~.-]{31,34})(?:$|[\\\\'\"\\x60\\s<),])",
      "pattern": "(?:^|[\\\\'\"\\x60\\s>=:(,)])([a-zA-Z0-9_~.]{3}\\dQ~[a-zA-Z0-9_~.-]{31,34})(?:$|[\\\\'\"\\x60\\s<),])",
      "flags": "gd",
      "keywords": [
        "Q~"
      ]
    },
    {
      "id": "gcp-api-key",
      "label": "gcp api key",
      "source_regex": "\\b(AIza[\\w-]{35})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "pattern": "\\b(AIza[\\w-]{35})(?:[\\x60'\"\\s;]|\\\\[nr]|$)",
      "flags": "gd",
      "keywords": [
        "AIza"
      ]
    }
  ]
}
