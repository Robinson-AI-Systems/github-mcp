# PC-WORKER-1: settings for the native Git worker on the owner's PC. install.sh copies this file to
# <home>/.env (mode 600) and fills the values it is given. Placeholders only: nothing here is a secret,
# and nothing secret ever belongs in this file. Runbook: docs/PC-WORKER.md.

# --- Required -------------------------------------------------------------------------------------
# The MCP's public verification key. Public, not a secret: copy the "public_key" value from
#   curl -fsS https://<mcp-domain>/api/native-git-key
# (install.sh --mcp-origin https://<mcp-domain> fetches it for you). It starts with "ed25519:".
NATIVE_GIT_CONTROL_PUBLIC_KEY=
# The MCP's own https origin (where the direct git host checks each git sign-in).
MCP_ORIGIN=https://<mcp-domain>
# This PC's public Tailscale Funnel origin (install.sh finds it from tailscale.exe when left empty).
PC_WORKER_PUBLIC_ORIGIN=https://<pc>.<tailnet>.ts.net

# --- Set by install.sh ----------------------------------------------------------------------------
# The full commit the image is built from (reported by github_server_status).
SOURCE_COMMIT=
# Worker data on WSL's ext4 disk (never under /mnt/).
PC_WORKER_DATA=/srv/robinson-git/data

# --- Optional: resource limits (defaults leave most of the PC free) -------------------------------
PC_WORKER_CPUS=4
PC_WORKER_MEMORY=6g
# CPU weight (Docker default 1024; lower = yields sooner), nice 0-19, ionice class 2 (best effort) or 3 (idle).
# (The IO weight is fixed at 100 of 1000 in compose.yaml.)
PC_WORKER_CPU_SHARES=256
PC_WORKER_NICE=10
PC_WORKER_IO_CLASS=3
PC_WORKER_PIDS=256
# New work is refused below these free amounts (memory in the container, disk on the data path).
NATIVE_GIT_MIN_AVAILABLE_MEMORY_MB=256
NATIVE_GIT_MIN_AVAILABLE_DISK_MB=20480
# How long "pc-worker pause" lets admitted work finish before stopping (seconds), and the longest
# graceful stop Docker waits for otherwise.
PC_WORKER_PAUSE_GRACE_SECONDS=30
PC_WORKER_STOP_GRACE=75s

# --- Optional: localhost ports inside WSL (bound to 127.0.0.1 only; Funnel points here) -----------
PC_WORKER_API_PORT=47300
PC_WORKER_GIT_PORT=47301

# --- Optional: Windows Tailscale CLI as seen from WSL ---------------------------------------------
# Always the Windows tailscale.exe (never a plain "tailscale" inside WSL, which may belong to another
# daemon on this machine).
PC_WORKER_TAILSCALE=/mnt/c/Program Files/Tailscale/tailscale.exe
# WORKER-POOL-1: optional cap on workspaces held on this PC at once (empty = resources only).
NATIVE_GIT_MAX_WORKSPACES=
