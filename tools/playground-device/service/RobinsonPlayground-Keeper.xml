<?xml version="1.0" encoding="UTF-16"?>
<!-- PLAY-3 §1.3 — the Windows keeper task: the FleetKit-WSL-KeepAlive pattern
     productized. A per-user task, running only while the enrolling user is
     signed in, whose whole job is to hold the PlaygroundWorker distro open
     (a WSL distro powers off ~30–90 s after its last session ends; systemd
     services inside do not hold it open). The task never runs the agent.
     Registered by the installer as "RobinsonPlayground-Keeper" for the
     enrolling user; %DISTRO% is replaced with the installed distro name
     (PlaygroundWorker, or its collision-suffixed variant). -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Keeps the Robinson Playground worker distro running while you are signed in, so your computer can host your own Playground work. Remove via the Playground setup app (Remove everything).</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>%USERID%</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%SystemRoot%\System32\wsl.exe</Command>
      <Arguments>-d %DISTRO% --exec sleep infinity</Arguments>
    </Exec>
  </Actions>
</Task>
