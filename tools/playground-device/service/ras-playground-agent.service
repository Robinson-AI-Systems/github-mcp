# PLAY-3 §1.3 — the host agent as a systemd service INSIDE the dedicated
# PlaygroundWorker WSL2 distro. systemd supervises the launcher shim
# (run.mjs), never a versioned payload directly; the shim owns update
# rollback. Installed by the PLAY-3 installer into /etc/systemd/system.
[Unit]
Description=Robinson Playground host agent (this computer runs its owner's Playground work)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=ras-playground
Group=ras-playground
WorkingDirectory=/home/ras-playground/.config/ras-playground
ExecStart=/usr/bin/node /home/ras-playground/.config/ras-playground/run.mjs run
Environment=RAS_PLAYGROUND_SUPERVISED=1
Restart=always
RestartSec=5s
# The agent's only deliberate privilege is the Docker engine socket of this
# product-owned distro, reached via the docker group on the worker account —
# the daemon, not the agent, writes /var/lib/docker.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
