def cmd_job_log(ns):
    if ns.job is not None:
        args = repo_args(ns)
        args["jobId"] = ns.job
        if ns.full:
            if ns.tail is not None:
                raise CliError("--full cannot be combined with --tail")
            args["fullText"] = True
            args["textOffset"] = ns.offset
            if ns.hash: args["expectedLogHash"] = ns.hash
        elif ns.offset or ns.hash:
            raise CliError("--offset and --hash require --full")
        if ns.tail is not None:
            args["tailLines"] = ns.tail
        emit(call_tool("github_actions_get_job_log", args))
    elif ns.run is not None:
        if ns.full or ns.offset or ns.hash:
            raise CliError("full-log windows need --job, not --run")
        args = repo_args(ns)
        args["runId"] = ns.run
        emit(call_tool("github_actions_get_run_logs_summary", args))
    else:
        raise CliError("job-log needs --job <job id> or --run <run id>")


