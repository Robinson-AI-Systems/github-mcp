def add_repo_args(parser):
    parser.add_argument("--owner", default="christcr2012",
                        help="GitHub account (default: christcr2012)")
    parser.add_argument("--repo", required=True, help="repository name")


def add_number_arg(parser):
    parser.add_argument("--number", type=int, required=True,
                        help="pull request number")


def repo_args(ns):
    return {"owner": ns.owner, "repo": ns.repo}


