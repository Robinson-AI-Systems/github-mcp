#!/usr/bin/env python3
"""ras-github — the one GitHub CLI for Chris's agents.

Wraps the Robinson GitHub MCP connector helper (custom.github-mcp) so every
GitHub operation goes through Chris's own connector — never the official
connector CLI (/opt/hatch/bin/github), whose writes generate approval cards.

Direct gateway tools are called straight through the helper; every other
catalogue tool goes through the helper's github_call gateway. Results are
printed exactly once (the server sends each result twice: text +
structuredContent; only the text payload is shown, pretty-printed if JSON).
"""

import argparse
import base64
import json
import re
import subprocess
import sys
import tempfile
import os
import uuid
import hashlib
import shutil

HELPER = os.path.abspath(os.path.expanduser(os.environ.get(
    "RAS_GITHUB_CONNECTOR_HELPER",
    "~/workspace/custom-connectors/custom.github-mcp/bin/client.py"
)))

# Keep only stable gateway tools here; all catalog operations use github_call.
# No duplicated per-operation allowlist is maintained.
DIRECT_TOOLS = {
    "github_call", "github_search_tools", "github_describe_tool",
}


SECRET_PATTERNS = [
    (re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}"), "<redacted-token>"),
    (re.compile(r"github_pat_[A-Za-z0-9_]{20,}"), "<redacted-token>"),
    (re.compile(r"hsurr:[^\s\"']+"), "<redacted>"),
    (re.compile(r"(?i)(bearer\s+)[A-Za-z0-9._\-]{20,}"), r"\1<redacted>"),
]


class CliError(Exception):
    """An expected failure; preserve a value-free receipt for recovery."""
    def __init__(self, message, receipt=None):
        super().__init__(message)
        self.receipt = receipt



def redact(text):
    for pattern, replacement in SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


# --------------------------------------------------------------------------
# Helper plumbing
# --------------------------------------------------------------------------

def run_helper(tool_name, arguments):
    """Call one tool through the connector helper; return the raw result dict."""
    fd, path = tempfile.mkstemp(prefix="ras-github-", suffix=".json")
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(arguments, handle)
        proc = subprocess.run(
            [sys.executable, HELPER, "call-tool",
             "--name", tool_name, "--arguments-file", path],
            capture_output=True, text=True, timeout=180,
        )
    except OSError as error:
        raise CliError("connector helper is unavailable: %s" % error.strerror)
    except subprocess.TimeoutExpired:
        raise CliError(
            "the GitHub connector did not answer in time; "
            "check the current state with a read before retrying"
        )
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    if proc.returncode != 0:
        detail = (proc.stderr or "").strip()
        detail = re.sub(r"^error:\s*", "", detail)
        # The helper still prints the result JSON on a tool error; prefer the
        # tool's own message when we can find it.
        text = extract_text(proc.stdout)
        if text:
            raise CliError(text.strip())
        raise CliError(detail or "the GitHub connector call failed")
    try:
        return json.loads(proc.stdout)
    except (ValueError, TypeError):
        raise CliError("the GitHub connector returned an unreadable result")


def extract_text(raw_stdout):
    """Pull the text payload out of a helper result, if it parses as one."""
    if not raw_stdout:
        return None
    try:
        result = json.loads(raw_stdout)
    except (ValueError, TypeError):
        return None
    return result_text(result)


def result_text(result):
    """The single text payload of an MCP result (never the structured copy)."""
    if not isinstance(result, dict):
        return None
    parts = []
    for item in result.get("content") or []:
        if isinstance(item, dict) and item.get("type") == "text":
            parts.append(item.get("text", ""))
    if parts:
        return "\n".join(parts)
    structured = result.get("structuredContent")
    if structured is not None:
        return json.dumps(structured, ensure_ascii=False)
    return None


def parse_payload(text):
    """Parse a text payload as JSON when it is JSON; else return the string."""
    if text is None:
        return None
    try:
        return json.loads(text)
    except (ValueError, TypeError):
        return text


def call_tool(tool_name, arguments):
    """Call any connector tool (direct or via github_call).

    Returns the parsed payload (dict/list) or raw text string.
    Raises CliError with the tool's own message on failure.
    """
    if tool_name in DIRECT_TOOLS:
        result = run_helper(tool_name, arguments)
    else:
        result = run_helper("github_call", {"name": tool_name, "args": arguments})
    if isinstance(result, dict) and result.get("isError"):
        message = result_text(result) or "the tool reported an error"
        raise CliError(redact(plain_message(message)))
    payload = parse_payload(result_text(result))
    if payload is None:
        raise CliError("the tool returned an empty result")
    # Change tools sometimes report failure inside an otherwise successful
    # result (status "uncertain" with an error field). Never let an agent
    # mistake that for success.
    if isinstance(payload, dict) and payload.get("error"):
        raise CliError(redact(plain_message(str(payload["error"]))))
    if isinstance(payload, dict) and payload.get("status") in {
        "refused", "refused_by_guard", "rejected", "uncertain", "unconfirmed", "failed"
    }:
        raise CliError(redact(str(payload.get("warning") or payload.get("reason") or
                                  "Operation was not confirmed; inspect state before retrying.")), payload)
    return payload


def plain_message(text):
    """Reduce a server error blob to its human sentence, when it is one.

    The server sometimes nests the real message inside a JSON envelope
    (possibly twice). Unwrap until we reach plain words.
    """
    message = text.strip()
    for _ in range(3):
        try:
            inner = json.loads(message)
        except ValueError:
            break
        if isinstance(inner, dict) and inner.get("error"):
            message = str(inner["error"]).strip()
        else:
            break
    return message


def emit(payload):
    """Print a result exactly once; pretty-print JSON compactly."""
    if isinstance(payload, (dict, list)):
        print(json.dumps(payload, indent=1, ensure_ascii=False))
    else:
        print(redact(str(payload)))


def request_key(tool_name):
    return "rasgh-%s-%s" % (tool_name.replace("github_", ""), uuid.uuid4().hex[:16])


def preview(tool_name, arguments):
    """Phase one of a change: dry-run preview only."""
    args = dict(arguments)
    args["dryRun"] = True
    args["requestKey"] = request_key(tool_name)
    return call_tool(tool_name, args)


def execute(tool_name, arguments):
    """One authorized owner write; never turn a failed result into success."""
    args = dict(arguments)
    args.setdefault("requestKey", request_key(tool_name))
    try:
        result = call_tool(tool_name, args)
    except CliError as error:
        raise CliError("%s Intent key: %s. Inspect state before retrying." % (error, args["requestKey"]), error.receipt)
    if not isinstance(result, dict) or result.get("preflight_failed") or result.get("done") is not True:
        message = result.get("warning") or result.get("reason") or result.get("error") if isinstance(result, dict) else None
        raise CliError(message or "Write was not confirmed; inspect state and the same intent before retrying.", result)
    if result.get("status") not in {"applied", "replayed", "complete"} or result.get("confirmed") is False:
        raise CliError("Write receipt is not a confirmed applied result; inspect it before retrying.", result)
    return result


